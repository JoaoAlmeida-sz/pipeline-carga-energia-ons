# Copie para .env. Nunca publique credenciais ou tokens.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=
SNOWFLAKE_WAREHOUSE=ONS_WH
SNOWFLAKE_DATABASE=ONS_ENERGIA

# Use PAT para execução automática. externalbrowser só funciona em contas com SSO compatível.
SNOWFLAKE_AUTH_METHOD=pat
SNOWFLAKE_PAT=
DBT_TARGET=prod
START_YEAR=2024

