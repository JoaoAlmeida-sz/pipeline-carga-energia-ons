# Copie para .env. Nunca publique credenciais ou tokens.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=ONS_WH
SNOWFLAKE_DATABASE=ONS_ENERGIA

# No computador: externalbrowser. Para Airflow sem navegador: pat.
SNOWFLAKE_AUTH_METHOD=externalbrowser
SNOWFLAKE_PAT=
DBT_TARGET=dev
START_YEAR=2024

